<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>
    <AssemblyName>Jime</AssemblyName>
    <RootNamespace>Jime</RootNamespace>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);third_party/**;Jime.Cli/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="third_party/**/*.cs;Jime.Cli/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos/protocol/*.proto" ProtoRoot="Protos" />
    <Content Include="third_party/runtime/SourceDir/PFiles/Mozc/**"
             Link="mozc/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
