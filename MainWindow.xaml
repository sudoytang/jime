<Window x:Class="Jime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="460" SizeToContent="Height" FontFamily="Yu Gothic UI, Segoe UI"
        UseLayoutRounding="True" MouseLeftButtonDown="OnDrag"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border CornerRadius="12" Background="#F71D2027" BorderBrush="#3DFFFFFF"
            BorderThickness="1" Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="2,0,2,8">
                <TextBlock Text="JIME · 日语输入" Foreground="#91FFFFFF" FontSize="11"/>
                <TextBlock Text="Ctrl + Alt + J" Foreground="#66FFFFFF" FontSize="11"
                           HorizontalAlignment="Right"/>
            </Grid>
            <Border Background="#18FFFFFF" CornerRadius="7" Padding="12,8" MouseLeftButtonDown="OnCompositionClick">
                <Grid>
                    <RichTextBox x:Name="InputView" MinHeight="34"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 Foreground="White" CaretBrush="White"
                                 SelectionBrush="#663867D6" SelectionOpacity="1" FontSize="23"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True" IsHitTestVisible="False"
                                 IsUndoEnabled="False" IsDocumentEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 InputMethod.IsInputMethodEnabled="False"/>
                    <Border Background="Transparent" Focusable="False"
                            MouseLeftButtonDown="OnCompositionClick"/>
                </Grid>
            </Border>
            <TextBlock x:Name="ReadingText" Margin="4,7,4,2" Foreground="#72FFFFFF"
                       FontSize="12" Text="输入罗马字，例如：ohayou"/>
            <ListBox x:Name="Candidates" BorderThickness="0" Background="Transparent"
                     Foreground="White" FontSize="18" MaxHeight="260"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnCandidateDoubleClick">
                <ListBox.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#FF3867D6"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Margin="4,9,4,0" Foreground="#70FFFFFF" FontSize="11" TextWrapping="Wrap"
                       Text="Space 确认候选 · 1–9 选择 · -/=、PgUp/PgDn 翻页 · Alt + -/= 输入原始 -/= · Alt+Enter 平假名 · Ctrl+Enter 片假名 · Enter 保留英文/输入 · Esc 取消"/>
        </StackPanel>
    </Border>
</Window>
